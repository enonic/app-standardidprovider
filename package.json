{
  "name": "app-standardidprovider",
  "version": "1.0.0",
  "description": "Standard Id provider application for Enonic XP Admin",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/enonic/app-standardidprovider"
  },
  "type": "module",
  "scripts": {
    "build": "concurrently -c auto -g --timings npm:build:*",
    "build:server": "cross-env BUILD_TARGET=server vite build",
    "build:static": "cross-env BUILD_TARGET=static vite build",
    "check:types": "tsc --noEmit -p tsconfig.xp.json",
    "lint": "eslint \"**/*.ts\" --quiet --cache",
    "fix": "eslint --fix \"**/*.ts\" --cache"
  },
  "devDependencies": {
    "@enonic-types/core": "^8.1.0",
    "@enonic-types/global": "^8.1.0",
    "@enonic-types/lib-admin": "^8.1.0",
    "@enonic-types/lib-auth": "^8.1.0",
    "@enonic-types/lib-context": "^8.1.1",
    "@enonic-types/lib-io": "^8.1.0",
    "@enonic-types/lib-node": "^8.1.0",
    "@enonic-types/lib-portal": "^8.1.0",
    "@enonic-types/lib-static": "^3.0.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "^8.71.1",
    "autoprefixer": "^10.6.1",
    "browserslist": "^4.29.1",
    "browserslist-config-enonic": "^1.0.8",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "cssnano": "^9.5.0",
    "enonic-admin-artifacts": "^2.5.0",
    "eslint": "^10.12.0",
    "eslint-config-xo": "^6.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "less": "^4.9.1",
    "postcss": "^8.5.30",
    "postcss-normalize": "^13.0.1",
    "postcss-sort-media-queries": "^6.7.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@enonic/js-utils": "^2.1.0",
    "check-password-strength": "^3.0.0",
    "jquery": "^4.0.0"
  },
  "browserslist": [
    "extends browserslist-config-enonic"
  ],
  "engines": {
    "node": ">= 24.20.0",
    "npm": ">= 11.19.0"
  }
}
